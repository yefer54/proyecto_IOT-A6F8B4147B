                <mxCell id="block_rfid" value="&lt;b style=&quot;font-size: 14px;&quot;&gt;SENSOR&lt;/b&gt;&lt;br/&gt;&lt;b style=&quot;font-size: 13px;&quot;&gt;Lector RFID MFRC522&lt;/b&gt;&lt;br/&gt;&lt;hr/&gt;• Lee tarjetas RFID (UID)&lt;br/&gt;• Comunicación: Bus SPI&lt;br/&gt;• Alimentación: 3.3V" style="shape=rectangle;whiteSpace=wrap;html=1;rounded=1;fillColor=#2980B9;strokeColor=#1B4F72;fontColor=#FFFFFF;align=center;verticalAlign=top;spacingTop=10;fontSize=12;shadow=1;" parent="1" vertex="1">
                    <mxGeometry x="50" y="130" width="230" height="140" as="geometry"/>
                </mxCell>
                <mxCell id="block_esp32" value="&lt;b style=&quot;font-size: 14px;&quot;&gt;MICROCONTROLADOR&lt;/b&gt;&lt;br/&gt;&lt;b style=&quot;font-size: 13px;&quot;&gt;ESP32 DevKit v1&lt;/b&gt;&lt;br/&gt;&lt;hr/&gt;• Valida la tarjeta (30 4F 8E C0)&lt;br/&gt;• Muestreo cada 850 ms&lt;br/&gt;• Controla Servo y LED&lt;br/&gt;• Bloqueo de 13s tras 3 rechazos" style="shape=rectangle;whiteSpace=wrap;html=1;rounded=1;fillColor=#2C3E50;strokeColor=#1A252F;fontColor=#FFFFFF;align=center;verticalAlign=top;spacingTop=10;fontSize=12;shadow=1;" parent="1" vertex="1">
                    <mxGeometry x="440" y="120" width="270" height="160" as="geometry"/>
                </mxCell>
                <mxCell id="block_servo" value="&lt;b style=&quot;font-size: 14px;&quot;&gt;ACTUADOR&lt;/b&gt;&lt;br/&gt;&lt;b style=&quot;font-size: 13px;&quot;&gt;Servomotor SG90&lt;/b&gt;&lt;br/&gt;&lt;hr/&gt;• Abre y cierra la puerta&lt;br/&gt;• Control: Señal PWM (50 Hz)&lt;br/&gt;• 0° (Cerrado) / 90° (Abierto)&lt;br/&gt;• Alimentación: 5V (VIN)" style="shape=rectangle;whiteSpace=wrap;html=1;rounded=1;fillColor=#D35400;strokeColor=#7E5109;fontColor=#FFFFFF;align=center;verticalAlign=top;spacingTop=8;fontSize=11;shadow=1;" parent="1" vertex="1">
                    <mxGeometry x="870" y="120" width="240" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="block_led" value="&lt;b style=&quot;font-size: 14px;&quot;&gt;INTERFAZ LOCAL&lt;/b&gt;&lt;br/&gt;&lt;b style=&quot;font-size: 13px;&quot;&gt;LED de Estado&lt;/b&gt;&lt;br/&gt;&lt;hr/&gt;• Indicador visual visual&lt;br/&gt;• Señal Digital (GPIO 2)&lt;br/&gt;• Encendido / Parpadeos Alerta&lt;br/&gt;• Resistencia 220 Ω" style="shape=rectangle;whiteSpace=wrap;html=1;rounded=1;fillColor=#27AE60;strokeColor=#145A32;fontColor=#FFFFFF;align=center;verticalAlign=top;spacingTop=8;fontSize=11;shadow=1;" parent="1" vertex="1">
                    <mxGeometry x="870" y="245" width="240" height="110" as="geometry"/>
                </mxCell>

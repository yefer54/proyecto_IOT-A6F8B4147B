                <mxCell id="sec3_title" value="3. RESUMEN DE INTERFACES Y ALIMENTACIÓN" style="text;html=1;strokeColor=none;fillColor=#EAECEE;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=13;fontStyle=1;fontColor=#2C3E50;" parent="1" vertex="1">
                    <mxGeometry x="40" y="740" width="1080" height="28" as="geometry"/>
                </mxCell>
                <mxCell id="tech_notes" value="&lt;b&gt;• Interfaz del Lector RFID (MFRC522):&lt;/b&gt; Utiliza comunicación por bus síncrono &lt;b&gt;SPI&lt;/b&gt; (SCK: GPIO 18, MISO: GPIO 19, MOSI: GPIO 23, CS: GPIO 5, RST: GPIO 21). Operación a 3.3V DC.&lt;br&gt;&lt;b&gt;• Interfaz del Servomotor :&lt;/b&gt; Control por pulsos de modulación &lt;b&gt;PWM&lt;/b&gt; a 50 Hz en GPIO 13. Alimentación a 5V DC (Línea VIN).&lt;br&gt;&lt;b&gt;• Interfaz Local (LED de Estado):&lt;/b&gt; Salida &lt;b&gt;Digital&lt;/b&gt; en GPIO 2 con resistencia limitadora de 220 Ω conectada a tierra." style="shape=rectangle;whiteSpace=wrap;html=1;rounded=1;fillColor=#F8F9F9;strokeColor=#BDC3C7;fontColor=#2C3E50;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="40" y="775" width="1080" height="70" as="geometry"/>
                </mxCell>
            </root>
